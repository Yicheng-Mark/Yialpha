# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=
# Alpha Vantage (daily price/volume + fundamentals). Free key: https://www.alphavantage.co/support/#api-key
#ALPHA_VANTAGE_API_KEY=
# Tavily (open-web search for the news analyst's web_search tool). Free tier
# 1,000 credits/month, no card: https://app.tavily.com — tvly-dev- prefix keys
# are the free tier. Without a key the tool degrades to a
# WEB_SEARCH_UNAVAILABLE sentinel + data_quality event (never aborts a run);
# disable the tool entirely with web_search_enabled=false in config.
# Per-run call cap: YIAGENTS_TAVILY_MAX_CALLS_PER_RUN (default 6, protects
# the monthly credits in batch runs). Per-call timeout:
# YIAGENTS_TAVILY_TIMEOUT_S (default 20). US-hosted: goes through the proxy.
#TAVILY_API_KEY=
# Reddit (optional OAuth for richer post data + bypass of public-feed 429).
# Create a "script" app at https://www.reddit.com/prefs/apps; use any URL as
# the redirect URI (the client_credentials grant never redirects). With both
# REDDIT_CLIENT_ID and REDDIT_CLIENT_SECRET set, the sentiment analyst's Reddit
# source pulls score/comment-count posts from oauth.reddit.com; without them the
# RSS feed path runs unchanged.
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=
# SEC EDGAR / 13F ownership: SEC asks for a descriptive contactable User-Agent
# on every request (read by yiagents/dataflows/sec_edgar.py:_user_agent). Set to
# your own identifier; the default works but is shared, so SEC rate limits may
# bite on heavy use.
#YIAGENTS_SEC_USER_AGENT=YiAgents research you@example.com
# Point-in-time guard for fundamental data (read by yiagents/dataflows/utils.py).
# yfinance / Alpha Vantage key financial statements by fiscalDateEnding (the
# period END), but a period ending e.g. Sep 30 is not public on Oct 1 -- the
# 10-Q is filed days/weeks later. This lag (in days) is added so a backtest
# only sees a statement once it was plausibly filed. 45 covers large accelerated
# filers (10-K ~60d, 10-Q ~40d); set to 0 to revert to lookahead-leaking behaviour.
#YIAGENTS_FUNDAMENTALS_FILING_LAG_DAYS=45

# Optional: a custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp,
# relay). Select provider "openai_compatible" and set the base URL; the key is
# optional (local servers need none).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (provider "bedrock", install with: pip install ".[bedrock]").
# Auth uses the standard AWS credential chain; set the region (and optionally a
# named profile). No single API key.
# AWS_REGION is read first (mirrors the AWS SDK/boto3 convention); falls back to
# AWS_DEFAULT_REGION (read by yiagents/llm_clients/bedrock_client.py:get_llm).
#AWS_DEFAULT_REGION=us-west-2
#AWS_REGION=us-west-2
#AWS_PROFILE=

# Azure OpenAI (provider "azure"). Unlike the OpenAI-compatible providers,
# Azure keys on a *deployment name* you create in the Azure portal, plus the
# resource endpoint and an API version. Read by yiagents/llm_clients/azure_client.py.
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT_NAME=
#OPENAI_API_VERSION=2025-03-01-preview

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Storage / output paths (optional). Override where YiAgents writes reports,
# caches downloaded market data, and stores its analyst memory log. Each
# defaults to a per-user directory under the OS data home; set these to
# relocate them (e.g. onto faster/larger storage). Read directly — not via
# the typed DEFAULT_CONFIG override block below.
#YIAGENTS_RESULTS_DIR=
#YIAGENTS_CACHE_DIR=
#YIAGENTS_MEMORY_LOG_PATH=

# Logging level for the YiAgents application (agents, dataflows, execution).
# Read by yiagents/logging_config.py at startup. Unset = INFO, so structured
# INFO/DEBUG messages from the codebase are visible by default (previously they
# were silently swallowed by Python's default WARNING-only root logger).
# Valid values: DEBUG / INFO / WARNING / ERROR / CRITICAL.
#YIAGENTS_LOG_LEVEL=INFO

# Analysis-only safety boundary. Keep these defaults for this repository's
# intended use: reports and backtests only, no order placement and no host-side
# execution of LLM-generated Python. Persistent memory is also opt-in because
# realised-return reflections require strict point-in-time bookkeeping.
# NOTE: with memory off, no decision/outcome evidence accumulates — the
# self-improvement loop (IC pruning, reflection) has nothing to learn from.
#YIAGENTS_ANALYSIS_ONLY=true
#YIAGENTS_LIVE_EXECUTION_ENABLED=false
#YIAGENTS_POT_ENABLED=false
#YIAGENTS_MEMORY_ENABLED=false

# Optional: override DEFAULT_CONFIG without editing code.
# Any YIAGENTS_* variable below, when set, replaces the matching key
# in yiagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#YIAGENTS_LLM_PROVIDER=openai
#YIAGENTS_DEEP_THINK_LLM=gpt-5.4
#YIAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# Debate-tier model: bull/bear researchers + risk debators (free-text
# adversarial argumentation). Unset = fall back to deep_think_llm, so the
# debate layer runs on the same model as the final-decision nodes. Override
# (e.g. deepseek-v4-flash) to A/B test a cheaper debate tier.
#YIAGENTS_DEBATE_LLM=deepseek-v4-pro
#YIAGENTS_LLM_BACKEND_URL=
#YIAGENTS_OUTPUT_LANGUAGE=English
#YIAGENTS_MAX_DEBATE_ROUNDS=1
#YIAGENTS_MAX_RISK_ROUNDS=1
#YIAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#YIAGENTS_TEMPERATURE=0.0
# Provider-specific reasoning/thinking depth (optional; unset = provider
# default). Setting one also skips the matching prompt.
#YIAGENTS_OPENAI_REASONING_EFFORT=medium
#YIAGENTS_GOOGLE_THINKING_LEVEL=high
#YIAGENTS_ANTHROPIC_EFFORT=high
# Expose WACC / margin-of-safety valuation as a Program-of-Thought tool to the
# fundamentals analyst. Off by default = byte-for-byte unchanged tool list.
# (Read by yiagents/default_config.py _ENV_OVERRIDES.)
#YIAGENTS_VALUATION_TOOLS=false

# --- Transport / retry hardening (zero impact on what is sent to the model) ---
# Per-request LLM read timeout (seconds). DeepSeek occasionally leaves a
# half-open socket (accepts the connection but never responds); without a
# timeout the call blocks forever and hangs the whole batch. Setting this
# makes such a call raise APITimeoutError so the SDK's built-in retry
# (max_retries below) can resend — usually recovering. Real calls land in
# <10s; 120s covers the heaviest reasoning call while still recovering from
# rare stalls. Read inline by yiagents/llm_clients/openai_client.py:get_llm().
#YIAGENTS_LLM_TIMEOUT_S=120
# Per-call retry count forwarded to the provider client (max_retries). Default
# 2 == langchain-openai's own default, so UNSET behaviour is byte-equivalent.
# Lower it during flaky periods (run_robust's per-ticker rerun is the outer
# safety net, so a single call need not retry itself to death).
#YIAGENTS_LLM_MAX_RETRIES=2
# Share one httpx.Client (keepalive) across every LLM call so worker graphs
# reuse TLS/SOCKS5-proxy connections. Transport-only — it changes nothing
# about what is sent to the model. Only wired for OpenAI-compatible providers
# (DeepSeek direct qualifies). Off by default.
#YIAGENTS_HTTP_KEEPALIVE=true
# Per-call timeout (seconds) for yfinance HTTP reads. yfinance's Ticker.info /
# get_news / Search take no per-call timeout argument, so this sets a
# process-wide socket.setdefaulttimeout as a backstop, plus timeout= on the
# OHLCV yf.download path (the call that actually hangs the pipeline). Off by
# default; 30s is a safe production value. Read inline by
# yiagents/dataflows/stockstats_utils.py.
#YIAGENTS_HTTP_TIMEOUT_S=30
# SOCKS5 / HTTP proxy for yfinance, Binance, and SEC EDGAR requests. The
# project declares PySocks as a runtime dep so these proxy URLs work out of the
# box. Set if you need to route market-data traffic through a proxy (e.g. to
# reach US data sources from a network without direct access). Consumed by the
# standard requests/httpx stacks; ALL_PROXY is the fallback when scheme-
# specific vars are absent (see yiagents/dataflows/utils.py:proxy_map).
#HTTP_PROXY=socks5h://127.0.0.1:1080
#HTTPS_PROXY=socks5h://127.0.0.1:1080
#ALL_PROXY=socks5h://127.0.0.1:1080
#NO_PROXY=localhost,127.0.0.1
# SOCKS5 proxy URL read at cli/main.py config-check for display. Mirrors the
# ALL_PROXY fallback semantics above (SOCKS5_PROXY checked first, then ALL_PROXY).
#SOCKS5_PROXY=socks5h://127.0.0.1:1080
# TCP keepalive for langchain-openai's httpx transport. Set to 1 to enable
# SO_KEEPALIVE on LLM connections (helps detect dead connections behind NAT /
# load balancers). Off (0) by default. Consumed by langchain-openai, not by
# yiagents code directly.
#LANGCHAIN_OPENAI_TCP_KEEPALIVE=0
# Binance perp data vendor: read the X-MBX-USED-WEIGHT-1M response header and
# back off before the per-IP per-minute weight ceiling (fapi default 2400/min)
# so the vendor avoids a 429 instead of only reacting to one. Off by default =
# the vendor neither reads the header nor sleeps (byte-equivalent). Only
# consulted when binance_proactive_backoff is on; the reactive 429/418 path is
# always the floor.
#YIAGENTS_BINANCE_PROACTIVE_BACKOFF=false
#YIAGENTS_BINANCE_WEIGHT_THRESHOLD=2400
# Binance transport resilience (read-only public market data). All default-off
# / zero = byte-equivalent to today (per-call fresh requests.get, no retry, no
# Retry-After sleep). keepalive reuses one requests.Session across calls (TLS/
# SOCKS5 connection pooling, mirrors YIAGENTS_HTTP_KEEPALIVE for the LLM side);
# retries recover transient DNS/timeout/TLS/5xx with exponential backoff
# (mirrors yf_retry, exhausted -> NoMarketDataError); honor_retry_after sleeps
# the server's Retry-After window (<=60s) before raising on 429/418.
#YIAGENTS_BINANCE_HTTP_KEEPALIVE=false
#YIAGENTS_BINANCE_HTTP_RETRIES=0
#YIAGENTS_BINANCE_HONOR_RETRY_AFTER=false

# --- Legacy execution adapter (not used by the analysis pipeline) -----------
# Leave every setting below disabled. A gateway now requires analysis_only=false
# plus BOTH LIVE_EXECUTION_ENABLED=true and EXECUTION_ENABLED=true, and rechecks
# them and the kill switch on every submission. No graph/report path calls it.
#BINANCE_API_KEY=
#BINANCE_API_SECRET=
#YIAGENTS_EXECUTION_ENABLED=false
#YIAGENTS_KILL_SWITCH=true
#YIAGENTS_EXECUTION_MAINNET=false
#YIAGENTS_EXECUTION_TIMEOUT_MS=10000
# Opt-in initial leverage for USDT-M perp symbols (set once per symbol via
# POST /fapi/v1/leverage). Unset/0 = leave each symbol at the account default.
# Leverage moves liquidation distance, not position size; with it set, a
# leverage call that fails REJECTS the order (fail-closed).
#YIAGENTS_EXECUTION_LEVERAGE=0

# --- Telemetry / analyst parallelism (observation only; off by default) -----
# Node-level wall-time + token telemetry: wraps every graph node handler,
# dumps node_perf_<date>.json next to full_states_log. Off = handlers pass
# through unwrapped (byte-equivalent). scripts/run_baseline.py --profile
# turns this on for a 1-ticker smoke.
#YIAGENTS_NODE_PERF_TELEMETRY=false
# Fan the 4 analysts out inside one wrapper node (each gets its own sub-graph
# state, so the shared `messages` / clear_node coupling is structurally
# avoided). OFF by default = today's serial analyst chain verbatim; flip on
# ONLY after scripts/run_analyst_parallel_ab.py passes its gate. Caps nested
# concurrency: analyst_parallel only engages when batch_workers*4 <=
# analyst_parallel_max_threads, else it silently falls back to serial.
#YIAGENTS_ANALYST_PARALLEL=false
#YIAGENTS_ANALYST_PARALLEL_MAX_THREADS=16
# Fetch the sentiment analyst's multiple data sources (Reddit, news, etc.) in
# parallel instead of serially (read by yiagents/agents/analysts/sentiment_analyst.py).
# Off by default = serial fetch; set to 1/true/yes/on to parallelise.
#YIAGENTS_SENTIMENT_PARALLEL_FETCH=false

# --- Quantitative risk overlay (read by default_config.py _ENV_OVERRIDES) ----
# The deterministic risk manager (on by default) overrides the analytical
# position size / stop-loss / exposure: LLM keeps direction, math owns size.
# scripts/run_baseline.py sets risk_enabled explicitly per mode, so this
# override mainly matters for ad-hoc single analyses.
#YIAGENTS_RISK_ENABLED=true
# Quarter-Kelly default; one ticker <= 20% of equity; one sector <= 30%;
# flatten + cool off beyond a 15% drawdown; stop = last_close - 2.0*ATR.
#YIAGENTS_KELLY_FRACTION=0.25
#YIAGENTS_MAX_POSITION=0.20
#YIAGENTS_MAX_SECTOR=0.30
#YIAGENTS_MAX_DRAWDOWN=0.15
#YIAGENTS_ATR_STOP_MULT=2.0

# --- Analyst prompt / data-source switches (all byte-equivalent when off) ----
# Swap the analyst persona prompts for compact FinCoT structured prompts
# (task -> reasoning steps -> output constraints). Off = baseline prompts.
#YIAGENTS_FIN_COT_PROMPTS=false
# Benchmark used for alpha / relative-return calculations (e.g. ^GSPC, 000300.SS).
# Unset = no benchmark overlay.
#YIAGENTS_BENCHMARK_TICKER=^GSPC
# SEC ownership & short-interest tools (Form 4 insider + fails-to-deliver +
# 13F holdings), PIT-correct, US-only. Opt-in tool additions for the
# fundamentals analyst.
#YIAGENTS_SEC_OWNERSHIP=false
# Point-in-time publication lags (days) for SEC data: FTD semi-monthly files
# are treated as public cutoff+10 days later; 13F quarterly ZIPs as
# period-end+45 days later (SEC's statutory deadline; keeps backtests from
# peeking and the honest "not yet published" message covers the gap).
#YIAGENTS_FTD_PUB_LAG_DAYS=10
#YIAGENTS_SEC_13F_PUB_LAG_DAYS=45
# Stale-cache age cap (days) for the shared data-vendor disk cache: when a
# vendor fails, a cache older than this is refused instead of served
# (fail-closed bound on outage staleness). 0 = never serve stale.
#YIAGENTS_DATA_CACHE_MAX_STALE_DAYS=30
# A-share opt-in tools (double-gated on A-share tickers .SS/.SH/.SZ):
# a_stock = Eastmoney margin trading; a_share_native = BaoStock 前复权 OHLC +
# server-computed TTM multiples + AKShare news/资金流/龙虎榜. Vendors connect
# directly (domestic sources; the SOCKS5 proxy is bypassed/popped for them).
#YIAGENTS_A_STOCK=false
#YIAGENTS_A_SHARE_NATIVE=false
# Market turbulence index (benchmark 252d squared-z) appended to the
# conservative risk debater's data sources. Advisory, fail-soft.
#YIAGENTS_MARKET_REGIME=false
# Composite regime context line in the market analyst's prompt: trend state
# (close vs 50/200 SMA + ADX strength), volatility state (rvol_20 percentile
# vs trailing year), benchmark turbulence, and (A-share live runs)
# whole-market breadth. ON by default; deterministic and fail-soft — any
# component that cannot be computed is omitted. Set false for the bare
# pre-expansion prompt.
#YIAGENTS_REGIME_CONTEXT=true

# --- Batch runner (multi-ticker) ----------------------------------------------
# Concurrency is OFF by default: every path stays strictly serial and
# reproducible. When on, batch_workers caps the pool size; the remaining
# switches control dedup and per-resource locking (leave the locks on).
#YIAGENTS_BATCH_CONCURRENCY=false
#YIAGENTS_BATCH_WORKERS=3
#YIAGENTS_BATCH_DEDUP_TICKERS=true
#YIAGENTS_BATCH_MEMORY_LOCK=true
#YIAGENTS_BATCH_OHLCV_LOCK=true
# False = a failed ticker does not abort the batch.
#YIAGENTS_BATCH_FAIL_FAST=false

# --- LLM cost / transport knobs (observation & economisation) ------------------
# Shared DeepSeek RPM ceiling. Off by default (per-call retries handle
# transient 429s); measure the ceiling first (G4 instrumentation).
#YIAGENTS_LLM_RATE_LIMITER=false
#YIAGENTS_LLM_RPM=60
# Per-call LLM response disk cache: identical (model+prompt+temperature+tools)
# replays the cached generation. Great while iterating on prompts; do NOT
# combine with run_analyst_parallel_ab.py or run_baseline --full (it collapses
# the run-to-run variability those distribution checks measure).
#YIAGENTS_LLM_CACHE=false
# Stream the graph + record per-analyst wall time (observation only).
#YIAGENTS_STREAM_TELEMETRY=false
# Binance SPOT vendor: use the key-free mirror data-api.binance.vision instead
# of api.binance.com (same data, Binance's recommended read-only host).
#YIAGENTS_BINANCE_SPOT_MIRROR=false

# --- run_robust.py internals (read directly, not via _ENV_OVERRIDES) ----------
# Override which child script run_robust launches (default: scripts/run_child.py)
# and where the socket-timeout shim directory is created. Rarely needed.
#YIAGENTS_ROBUST_CHILD_SCRIPT=
#YIAGENTS_TIMEOUT_SHIM_DIR=
